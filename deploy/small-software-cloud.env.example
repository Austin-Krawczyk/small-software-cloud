# Environment for the Small Software Cloud control plane.
# Copy to /etc/small-software-cloud.env and edit. Loaded by the systemd unit.

# The platform's public domain. Apps are served at {slug}.<this domain>.
# A wildcard DNS record (*.example.com) must point at this server.
SCLOUD_BASE_HOST=example.com

# Public scheme. Keep https in production (Caddy terminates TLS); this also
# makes session cookies Secure and app URLs https://…
SCLOUD_PROTO=https

# Where persistent state lives (SQLite DB, app builds, uploads, logs).
# Kept outside the code checkout so redeploys don't touch it.
SCLOUD_DATA_DIR=/var/lib/small-software-cloud

# Bind the control plane to loopback only — it is reachable exclusively through
# Caddy, never directly from the internet.
HOSTNAME=127.0.0.1
PORT=3000
NODE_ENV=production
