# Environment for the Small Software Cloud control plane.
# Copy to /etc/small-software-cloud.env and edit. Loaded by the systemd unit.

# The platform's public domain. Apps are served at {slug}.<this domain>.
# A wildcard DNS record (*.example.com) must point at this server.
SCLOUD_BASE_HOST=example.com

# Public scheme. Keep https in production (Caddy terminates TLS); this also
# makes session cookies Secure and app URLs https://…
SCLOUD_PROTO=https

# Where persistent state lives (SQLite DB, app builds, uploads, logs).
# Kept outside the code checkout so redeploys don't touch it.
SCLOUD_DATA_DIR=/var/lib/small-software-cloud

# Bind the control plane to loopback only — it is reachable exclusively through
# Caddy, never directly from the internet.
HOSTNAME=127.0.0.1
PORT=3000
NODE_ENV=production

# Size caps (MB). Raise for larger apps. The upload cap gates the uploaded zip;
# the project cap gates the extracted/cloned project on disk. Note: uploads are
# read into memory, so very large values want more RAM/swap on the server.
#SCLOUD_MAX_UPLOAD_MB=50
#SCLOUD_MAX_PROJECT_MB=200

# Max apps running at once (each uses up to 256 MB). At capacity, the least-
# recently-used app is paused and wakes on its next request. Raise it on a
# bigger droplet: ~5 for 1 GB RAM, ~10 for 2 GB, ~20 for 4 GB.
#SCLOUD_MAX_RUNNING_APPS=5

# Email for share invites (optional). Without these, invites still work — the
# person just isn't emailed (the message is written to data/mail-outbox.log).
# Use any SMTP provider (e.g. an app password, Postmark, SES, Resend SMTP, …).
#SCLOUD_SMTP_HOST=smtp.example.com
#SCLOUD_SMTP_PORT=587
#SCLOUD_SMTP_USER=apikey-or-username
#SCLOUD_SMTP_PASS=your-smtp-password
#SCLOUD_SMTP_FROM=Small Software Cloud <no-reply@yourdomain.com>
#SCLOUD_SMTP_SECURE=false   # true for port 465

# Google sign-in (optional). Create an OAuth client at
# https://console.cloud.google.com/apis/credentials (type: Web application) and
# add this Authorized redirect URI:  https://YOURDOMAIN/api/auth/google/callback
#SCLOUD_GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
#SCLOUD_GOOGLE_CLIENT_SECRET=your-google-client-secret
