# Checks GitHub for new commits every 5 minutes and redeploys when there are any.
# Enable via install-autoupdate.sh (or: systemctl enable --now this timer).

[Unit]
Description=Check for Small Software Cloud updates every few minutes

[Timer]
OnBootSec=3min
OnUnitActiveSec=5min
RandomizedDelaySec=30s
Persistent=true

[Install]
WantedBy=timers.target
